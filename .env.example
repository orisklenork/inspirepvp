# Supabase (Server-side only — never prefix service role key with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (Client-side public config)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional secret used to sign stateless session cookies (falls back to SUPABASE_SERVICE_ROLE_KEY if omitted)
SESSION_SECRET=
